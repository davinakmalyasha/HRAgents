    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "i18next": "^26.5.5",
    "lucide-react": "^1.61.0",
    "openapi-fetch": "^0.17.0",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.2",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
