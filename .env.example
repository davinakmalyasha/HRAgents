# HRAgents environment configuration.
# Copy to `.env` and adjust. Never commit `.env`.

# --- Application ---
HRAGENTS_APP_NAME=HRAgents
HRAGENTS_ENVIRONMENT=local
HRAGENTS_LOG_LEVEL=INFO
HRAGENTS_DEBUG=false

# Inbound API keys (JSON list). Empty/absent = auth disabled (local dev only).
# HRAGENTS_API_KEYS=["dev-key-1","partner-key-2"]

# --- Database (matches docker-compose.yml) ---
HRAGENTS_DATABASE_URL=postgresql+asyncpg://hragents:hragents@localhost:5432/hragents

# --- Redis ---
HRAGENTS_REDIS_URL=redis://localhost:6379/0

# --- Object storage / MinIO ---
HRAGENTS_S3_ENDPOINT_URL=http://localhost:9000
HRAGENTS_S3_ACCESS_KEY=hragents
HRAGENTS_S3_SECRET_KEY=hragents123
HRAGENTS_S3_BUCKET=hragents-documents

# --- LLM provider (adaptive: pick any provider) ---
# Defaults to the offline "test" model when unset — the system runs with no keys.
#
# Command Code Provider API (GOAT/Pro/Max/Provider plans; one key, all models;
# zero data retention on by default — recommended):
# HRAGENTS_PROVIDER_LLM=llm.commandcode
# HRAGENTS_PROVIDER_LLM_CONFIG={"api_key":"cmd-...","model":"xiaomi/mimo-v2.5"}
#   MiMo options: xiaomi/mimo-v2.5  ·  xiaomi/mimo-v2.5-pro
#   Get the key at https://commandcode.ai/settings/keys
#
# Anthropic:
# HRAGENTS_PROVIDER_LLM=llm.anthropic
# HRAGENTS_PROVIDER_LLM_CONFIG={"api_key":"sk-ant-...","model":"claude-sonnet-4-5"}
#
# OpenAI / OpenRouter / Groq / vLLM / any OpenAI-compatible gateway:
# HRAGENTS_PROVIDER_LLM=llm.openai_compatible
# HRAGENTS_PROVIDER_LLM_CONFIG={"model":"gpt-4o-mini","api_key":"sk-...","base_url":"https://api.openai.com/v1"}
#
# Local models via Ollama (data never leaves the machine):
# HRAGENTS_PROVIDER_LLM=llm.ollama
# HRAGENTS_PROVIDER_LLM_CONFIG={"model":"qwen2.5-coder","base_url":"http://localhost:11434/v1"}
#
# Optional: lock a provider so the Settings UI shows a padlock
# HRAGENTS_PROVIDER_LLM_LOCK=true

# --- Queue provider (default: memory for single-node dev; redis in compose) ---
# HRAGENTS_PROVIDER_QUEUE=queue.redis
# HRAGENTS_PROVIDER_QUEUE_CONFIG={"redis_url":"redis://localhost:6379/0"}

# --- External integrations (optional in local dev) ---
HRAGENTS_GITHUB_TOKEN=
HRAGENTS_CROSSREF_MAILTO=team@example.com

# --- Messaging bridges ("true" = no live sends, sandbox only) ---
HRAGENTS_MESSAGING_SANDBOX=true
HRAGENTS_WHATSAPP_PHONE_NUMBER_ID=
HRAGENTS_WHATSAPP_ACCESS_TOKEN=
HRAGENTS_TELEGRAM_BOT_TOKEN=
HRAGENTS_SMTP_HOST=localhost
HRAGENTS_SMTP_PORT=1025
HRAGENTS_SMTP_FROM=hragents@example.com
